  <script>(function(){function m(a){var h=a.getAttribute("href");if(!h)return;try{var u=new URL(h,document.baseURI);if((u.protocol==="http:"||u.protocol==="https:")&&u.host!==location.host){a.target="_blank";a.rel="noopener noreferrer";}}catch(e){}}function s(){document.querySelectorAll("a[href]").forEach(m);}if(document.readyState!=="loading"){s();}else{document.addEventListener("DOMContentLoaded",s);}document.addEventListener("click",function(e){var a=e.target&&e.target.closest&&e.target.closest("a[href]");if(a){m(a);}},true);})();</script>
  
<section id="founding-application" style="max-width:760px;margin:4rem auto;padding:2rem;border:1px solid #3f3f46;border-radius:16px;background:#101012;color:#f4f4f5;font-family:system-ui,sans-serif"><h2>Apply to the Founding Program</h2><p>Apply for the Free Startup Track or a Golden Ticket founding slot. Tell us what you are deploying and why your team should be selected.</p><form action="mailto:docspoc101@gmail.com" method="post" enctype="text/plain"><p><label>Name<br><input required name="name"></label></p><p><label>Email<br><input required type="email" name="email"></label></p><p><label>Company or project<br><input required name="company_project"></label></p><p><label>Website or repository<br><input name="website_repo"></label></p><p><label>Agent stack<br><textarea required name="agent_stack"></textarea></label></p><p><label>Deployment stage<br><select required name="deployment_stage"><option value="">Select one</option><option>Prototype</option><option>Private beta</option><option>Production</option><option>Scaling production deployment</option></select></label></p><p><label>What governance problem must SHACKLE solve?<br><textarea required name="governance_problem"></textarea></label></p><p><label>Why should SHACKLE select you?<br><textarea required name="why_selected"></textarea></label></p><p><label><input required type="checkbox" name="consent"> I consent to SHACKLE contacting me about this application.</label></p><button type="submit">Submit application</button></form></section></body>
</html>